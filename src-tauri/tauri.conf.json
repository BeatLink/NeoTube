{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoTube",
  "version": "0.1.0",
  "identifier": "app.neotube",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NeoTube",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https://i.ytimg.com https://yt3.ggpht.com https://yt3.googleusercontent.com",
        "media-src": "'self' blob: https://*.googlevideo.com",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:7700 https://www.youtube.com https://music.youtube.com https://*.googlevideo.com https://i.ytimg.com https://yt3.ggpht.com https://yt3.googleusercontent.com",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
